@*
    The page shell of every signed-in page: top bar, side menu (_Sidebar), page header, messages, content, footer.
    The four role layouts (_Layout = Admin, _SupportManegerLayout, _SupportEngineerLayout, _MakerLayout) use it.
    A page sets ViewData["Title"] (and optionally ViewData["Subtitle"]) for its header and can put buttons
    next to the title with  @section PageActions { ... }.
*@
@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var title = ViewData["Title"] as string;
    var subtitle = ViewData["Subtitle"] as string;
    // the header (and its buttons) belongs to pages with a title
    if (string.IsNullOrEmpty(title) && IsSectionDefined("PageActions")) { IgnoreSection("PageActions"); }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(title) ? "XFL CSMS" : title + " | XFL CSMS")</title>
    <partial name="_XflHead" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button" title="Show / hide the menu" aria-label="Show / hide the menu"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="javascript:history.back()" title="Back"><i class="fas fa-arrow-left"></i><span class="d-none d-sm-inline ml-1">Back</span></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-controller="@controller" asp-action="Dashbord" class="nav-link"><i class="fas fa-home mr-1"></i>Home</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <partial name="~/Views/Shared/Notifications/_Bell.cshtml" />
                <li class="nav-item d-none d-md-block">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button" title="Full screen" aria-label="Full screen"><i class="fas fa-expand-arrows-alt"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-danger" asp-controller="@controller" asp-action="Logout" title="Log Out"><i class="fas fa-sign-out-alt"></i><span class="d-none d-sm-inline ml-1">Log Out</span></a>
                </li>
            </ul>
        </nav>

        <partial name="_Sidebar" />

        <div class="content-wrapper">
            @if (!string.IsNullOrEmpty(title))
            {
                <div class="xfl-page-header">
                    <div class="xfl-page-heading">
                        <h1 class="xfl-page-title">@title</h1>
                        @if (!string.IsNullOrEmpty(subtitle))
                        {
                            <p class="xfl-page-subtitle">@subtitle</p>
                        }
                    </div>
                    <div class="xfl-page-actions">@await RenderSectionAsync("PageActions", required: false)</div>
                </div>
            }
            <section class="content xfl-content">
                @* one-off messages set by the controllers (ticket created, file rejected, ...) *@
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        @TempData["ErrorMessage"]
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        @TempData["SuccessMessage"]
                    </div>
                }
                @RenderBody()
            </section>
        </div>

        <footer class="main-footer">
            <div class="float-right d-none d-sm-inline-block"><b>Version</b> 1.1.0</div>
            <strong>Copyright &copy; 2024 <a href="https://xpertfintech.com">Xpert Fintech Limited</a>.</strong> All rights reserved.
        </footer>
    </div>

    <script src="~/plugins/bs-custom-file-input/bs-custom-file-input.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // developer tools shortcuts are blocked, as before
        document.onkeydown = function (e) {
            if (e.keyCode == 123) { return false; }
            if (e.ctrlKey && e.shiftKey && (e.keyCode == 73 || e.keyCode == 74)) { return false; }
            if (e.ctrlKey && e.keyCode == 85) { return false; }
        };
    </script>
</body>
</html>
