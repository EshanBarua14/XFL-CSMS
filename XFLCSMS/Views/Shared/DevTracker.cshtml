@model XFLCSMS.Models.Tiers.DevTrackerView
@using XFLCSMS.Models.Tiers
@using System.Globalization
@*
    Development Tracker (CsmsController.DevTracker): every ticket that needs a code change, as a board by stage
    (analysis, development, code review, QA / UAT, ready to deploy, deployed, on hold), with owner, ETA and level.
    The stage is changed on the ticket page (Support level & development panel).
*@
@{
    Layout = Model.Layout;
    var ctl = Model.Controller;
    ViewData["Title"] = "Development Tracker";
    ViewData["Subtitle"] = "Tickets that need a code change, from analysis to deployment. Change a stage on the ticket page.";
    string Day(DateTime? d) => d.HasValue ? d.Value.ToString("dd MMM", CultureInfo.InvariantCulture) : "no ETA";
    var overdue = Model.Rows.Count(r => r.Overdue);
}
@section PageActions {
    <form asp-controller="@ctl" asp-action="DevTracker" method="get" class="form-inline">
        <select name="ownerId" class="form-control form-control-sm mr-2" onchange="this.form.submit()" aria-label="Owner">
            <option value="">Every owner</option>
            @foreach (var o in Model.Owners)
            {
                <option value="@o.Id" selected="@(o.Id == Model.OwnerId)">@o.Name@(o.OpenTickets > 0 ? " (" + o.OpenTickets + ")" : "")</option>
            }
        </select>
        <div class="custom-control custom-switch mr-2">
            <input type="checkbox" class="custom-control-input" id="show-deployed" name="deployed" value="true" @(Model.ShowDeployed ? "checked" : "") onchange="this.form.submit()" />
            <label class="custom-control-label small" for="show-deployed">All deployed</label>
        </div>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="@ctl" asp-action="SupportTiers"><i class="fas fa-layer-group mr-1"></i>Support Levels</a>
    </form>
}

<section class="content">
    <div class="container-fluid">
        <p class="small text-muted mb-2">
            @Model.Rows.Count(r => DevStages.IsActive(r.Stage)) in progress
            @if (overdue > 0)
            {
                <span class="text-danger"> · @overdue past their ETA</span>
            }
            · deployed in the last 14 days @(Model.ShowDeployed ? "and earlier " : "")shown in the last column.
        </p>
        <div class="xfl-board">
            @foreach (var stage in DevStages.Pipeline.Append(DevStages.All.Last()))
            {
                var items = Model.Rows.Where(r => r.Stage == stage.Value).ToList();
                <div class="xfl-board-col xfl-dev-@stage.Value.ToLowerInvariant()">
                    <h3><i class="@stage.Icon"></i>@stage.Label <span class="badge badge-pill badge-light">@items.Count</span></h3>
                    @foreach (var r in items)
                    {
                        <a class="xfl-board-card xfl-dev-@stage.Value.ToLowerInvariant() @(r.Overdue ? "is-overdue" : "")" asp-controller="@ctl" asp-action="TicketView" asp-route-id="@r.IssueId">
                            <div class="d-flex align-items-center mb-1" style="gap:6px">
                                <b class="small">@r.Number</b>
                                <span class="xfl-lvl xfl-lvl-sm xfl-lvl-@SupportLevel.Clamp(r.Level)">@SupportLevel.Code(SupportLevel.Clamp(r.Level))</span>
                                @if (r.Priority == "High")
                                {
                                    <span class="badge badge-danger">High</span>
                                }
                                @if (r.Status == "Close")
                                {
                                    <span class="badge badge-success">Closed</span>
                                }
                            </div>
                            <div class="t" title="@r.Title">@r.Title</div>
                            <div class="meta">
                                <span><i class="fas fa-user mr-1"></i>@(r.Owner ?? "no owner")</span>
                                <span class="@(r.Overdue ? "text-danger font-weight-bold" : "")"><i class="far fa-calendar mr-1"></i>@Day(r.Eta)</span>
                                @if (!string.IsNullOrEmpty(r.House))
                                {
                                    <span><i class="fas fa-building mr-1"></i>@r.House</span>
                                }
                                <span title="Time in this stage"><i class="far fa-clock mr-1"></i>@(r.DaysInStage < 1 ? "today" : Math.Floor(r.DaysInStage) + "d")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Reference))
                            {
                                <div class="meta"><code>@r.Reference</code></div>
                            }
                            @if (!string.IsNullOrEmpty(r.LastNote))
                            {
                                <div class="meta text-truncate" title="@r.LastNote">“@r.LastNote”</div>
                            }
                        </a>
                    }
                    @if (items.Count == 0)
                    {
                        <div class="xfl-board-empty">Nothing here</div>
                    }
                </div>
            }
        </div>
    </div>
</section>
