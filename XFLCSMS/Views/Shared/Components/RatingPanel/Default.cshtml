@model XFLCSMS.Models.Feedback.RatingPanelView
@{
    var r = Model.Rating;
    string Stars(int n) => new string('★', n) + new string('☆', 5 - n);
    string Sub(byte? v) => v.HasValue ? Stars(v.Value) : "-";
}
<div class="card card-outline @(r == null ? "card-secondary" : r.Stars <= 2 ? "card-danger" : "card-success")">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-star mr-1"></i> Client Rating <small class="text-muted ml-2">visible to Admin and Support Manager only</small></h3>
        <div class="card-tools">
            <a asp-controller="@Model.Controller" asp-action="ServiceFeedback" class="btn btn-tool" title="All feedback"><i class="fas fa-list"></i></a>
        </div>
    </div>
    <div class="card-body">
        @if (r == null)
        {
            @if (!Model.IsClosed)
            {
                <p class="mb-0 text-muted">The client can rate this ticket once it is closed.</p>
            }
            else if (Model.RateUntil >= DateTime.Now)
            {
                <p class="mb-0 text-muted">Not rated yet. The client can rate until @Model.RateUntil?.ToString("dd MMM yyyy").</p>
            }
            else
            {
                <p class="mb-0 text-muted">Not rated. The rating period ended on @Model.RateUntil?.ToString("dd MMM yyyy").</p>
            }
        }
        else
        {
            <div class="row">
                <div class="col-md-4">
                    <div style="font-size: 1.6rem; color: #f39c12;" title="@r.Stars of 5">@Stars(r.Stars)</div>
                    <div><b>@r.Stars / 5</b> for <b>@(r.EngineerName ?? "(no engineer)")</b></div>
                    <div class="text-muted small">Rated @r.CreatedOn.ToString("dd MMM yyyy HH:mm")@(r.UpdatedOn != null ? ", changed " + r.UpdatedOn.Value.ToString("dd MMM yyyy HH:mm") : "")</div>
                    <div class="mt-1">
                        @if (r.FullySolved)
                        {
                            <span class="badge badge-success">Fully solved</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Not fully solved</span>
                        }
                    </div>
                </div>
                <div class="col-md-3 small">
                    <div>Speed: <span style="color: #f39c12;">@Sub(r.SpeedScore)</span></div>
                    <div>Communication: <span style="color: #f39c12;">@Sub(r.CommunicationScore)</span></div>
                    <div>Solution quality: <span style="color: #f39c12;">@Sub(r.QualityScore)</span></div>
                </div>
                <div class="col-md-5">
                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                    {
                        <blockquote class="mb-1" style="white-space: pre-wrap;">@r.Comment</blockquote>
                    }
                    else
                    {
                        <p class="text-muted">No written feedback.</p>
                    }
                </div>
            </div>
            <hr />
            @if (r.ReviewedOn != null)
            {
                <p class="mb-0 small"><i class="fas fa-check-circle text-success"></i> Reviewed by <b>@r.ReviewedBy</b> on @r.ReviewedOn.Value.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(r.ReviewNote) ? "" : ": " + r.ReviewNote)</p>
            }
            else
            {
                <form asp-controller="@Model.Controller" asp-action="ReviewRating" method="post" class="form-inline">
                    <input type="hidden" name="ratingId" value="@r.RatingId" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <input type="text" name="note" maxlength="1000" class="form-control form-control-sm mr-2 mb-1" style="min-width: 320px;" placeholder="Internal follow-up note (optional)" />
                    <button type="submit" class="btn btn-sm @(r.Stars <= 2 ? "btn-danger" : "btn-outline-secondary") mb-1"><i class="fas fa-check"></i> Mark as reviewed</button>
                </form>
            }
        }

        @if (Model.History.Count > 0)
        {
            <details class="mt-3">
                <summary class="text-muted small">Status history (@Model.History.Count)</summary>
                <table class="table table-sm table-striped mt-2 mb-0 small">
                    <thead><tr><th>When</th><th>From</th><th>To</th><th>By</th></tr></thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr><td>@h.ChangedOn.ToString("dd MMM yyyy HH:mm")</td><td>@(h.FromStatus ?? "(created)")</td><td>@h.ToStatus</td><td>@h.ChangedByName</td></tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    </div>
</div>
