@model XFLCSMS.Models.Feedback.RatingPanelView
@using XFLCSMS.Models.Feedback
@{
    var r = Model.Rating;
    string Stars(int n) => new string('★', n) + new string('☆', 5 - n);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var effort = new[] { "", "Very difficult", "Difficult", "Neutral", "Easy", "Very easy" };
}
<link rel="stylesheet" href="~/css/xfl-perf.css" asp-append-version="true" />
<div class="card card-outline @(r == null ? "card-secondary" : r.NeedsFollowUp ? "card-danger" : "card-success")">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-star mr-1"></i> Client Rating <small class="text-muted ml-2">visible to Admin and Support Manager only</small></h3>
        <div class="card-tools">
            <a asp-controller="@Model.Controller" asp-action="ServiceFeedback" class="btn btn-tool" title="All feedback"><i class="fas fa-list"></i></a>
        </div>
    </div>
    <div class="card-body">
        @if (r == null)
        {
            @if (!Model.IsClosed)
            {
                <p class="mb-0 text-muted">The client can rate this ticket once it is closed.</p>
            }
            else if (Model.RateUntil >= DateTime.Now)
            {
                <p class="mb-0 text-muted">Not rated yet. The client can rate until @Model.RateUntil?.ToString("dd MMM yyyy").</p>
            }
            else
            {
                <p class="mb-0 text-muted">Not rated. The rating period ended on @Model.RateUntil?.ToString("dd MMM yyyy").</p>
            }
        }
        else
        {
            <div class="row">
                <div class="col-md-4">
                    <div style="font-size: 1.6rem; color: #f39c12;" title="@r.Stars of 5">@Stars(r.Stars)</div>
                    <div><b>@r.Stars / 5</b> for <b>@(r.EngineerName ?? "(no engineer)")</b></div>
                    <div class="text-muted small">Rated @r.CreatedOn.ToString("dd MMM yyyy HH:mm")@(r.UpdatedOn != null ? ", changed " + r.UpdatedOn.Value.ToString("dd MMM yyyy HH:mm") : "")</div>
                    <div class="mt-1">
                        <span class="badge @(r.FullySolved ? "badge-success" : "badge-danger")">@(r.FullySolved ? "Fully solved" : "Not fully solved")</span>
                        @if (r.FirstContactResolved != null)
                        {
                            <span class="badge @(r.FirstContactResolved == true ? "badge-success" : "badge-warning")">@(r.FirstContactResolved == true ? "Solved first time" : "Had to chase")</span>
                        }
                        @if (r.ExcludedFromScore)
                        {
                            <span class="badge badge-secondary" title="@r.ExcludeReason">Not counted in scorecard</span>
                        }
                    </div>
                </div>
                <div class="col-md-4 small">
                    @foreach (var (label, v) in new[] { ("Speed", r.SpeedScore), ("Communication", r.CommunicationScore), ("Solution quality", r.QualityScore), ("Professionalism", r.ProfessionalismScore), ("Knowledge", r.KnowledgeScore) })
                    {
                        <div class="d-flex align-items-center mb-1">
                            <span style="width: 120px;">@label</span>
                            @if (v.HasValue)
                            {
                                <div class="score-bar flex-fill mr-2"><span style="width: @(v.Value * 20)%;"></span></div><b>@v</b>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    }
                    <div class="mt-2">
                        Effort (CES): <b>@(r.EffortScore.HasValue ? r.EffortScore + " · " + effort[r.EffortScore.Value] : "-")</b><br />
                        Recommend (NPS): <b>@(r.RecommendScore?.ToString() ?? "-")</b>
                        @if (r.RecommendScore != null)
                        {
                            var kind = r.RecommendScore >= 9 ? ("Promoter", "badge-success") : r.RecommendScore >= 7 ? ("Passive", "badge-warning") : ("Detractor", "badge-danger");
                            <span class="badge @kind.Item2">@kind.Item1</span>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    @foreach (var t in r.TagList)
                    {
                        <span class="tag-chip @(FeedbackTags.IsPositive(t) ? "pos" : "neg")">@t</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                    {
                        <blockquote class="mb-1 mt-1" style="white-space: pre-wrap;">@r.Comment</blockquote>
                    }
                    else
                    {
                        <p class="text-muted">No written feedback.</p>
                    }
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-6">
                    <h6 class="small font-weight-bold text-uppercase text-muted">Internal follow-up</h6>
                    @if (r.ReviewedOn != null)
                    {
                        <p class="mb-0 small"><i class="fas fa-check-circle text-success"></i> Reviewed by <b>@r.ReviewedBy</b> on @r.ReviewedOn.Value.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(r.ReviewNote) ? "" : ": " + r.ReviewNote)</p>
                    }
                    else
                    {
                        @if (r.NeedsFollowUp && r.CreatedOn.AddHours(XFLCSMS.Services.FeedbackService.FollowUpHours) < DateTime.Now)
                        {
                            <p class="small text-danger mb-1"><i class="fas fa-exclamation-triangle"></i> Follow-up overdue (target @XFLCSMS.Services.FeedbackService.FollowUpHours hours).</p>
                        }
                        <form asp-controller="@Model.Controller" asp-action="ReviewRating" method="post" class="form-inline">
                            <input type="hidden" name="ratingId" value="@r.RatingId" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <input type="text" name="note" maxlength="1000" class="form-control form-control-sm mr-2 mb-1 flex-fill" placeholder="Internal follow-up note (optional)" />
                            <button type="submit" class="btn btn-sm @(r.NeedsFollowUp ? "btn-danger" : "btn-outline-secondary") mb-1"><i class="fas fa-check"></i> Mark as reviewed</button>
                        </form>
                    }

                    <details class="mt-2">
                        <summary class="small">@(r.ExcludedFromScore ? "Count this rating in the scorecard again" : "Leave this rating out of the scorecard")</summary>
                        <form asp-controller="@Model.Controller" asp-action="ExcludeRating" method="post" class="mt-2">
                            <input type="hidden" name="ratingId" value="@r.RatingId" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <input type="hidden" name="exclude" value="@(r.ExcludedFromScore ? "false" : "true")" />
                            @if (r.ExcludedFromScore)
                            {
                                <p class="small mb-1">Left out by @r.ExcludedBy: @r.ExcludeReason</p>
                            }
                            else
                            {
                                <input type="text" name="reason" maxlength="500" class="form-control form-control-sm mb-1" placeholder="Reason, e.g. the rating is about a product limitation, not the engineer (required)" required />
                            }
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(r.ExcludedFromScore ? "Count again" : "Leave out")</button>
                        </form>
                    </details>
                </div>
                <div class="col-md-6">
                    <h6 class="small font-weight-bold text-uppercase text-muted">Reply to the client</h6>
                    @if (!string.IsNullOrWhiteSpace(r.ClientReply))
                    {
                        <div class="callout callout-info py-2 mb-2 small">
                            <span style="white-space: pre-wrap;">@r.ClientReply</span>
                            <div class="text-muted">@r.ClientReplyBy, @r.ClientReplyOn?.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    }
                    <form asp-controller="@Model.Controller" asp-action="ReplyToClient" method="post">
                        <input type="hidden" name="ratingId" value="@r.RatingId" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <textarea name="reply" class="form-control form-control-sm mb-1" rows="2" maxlength="1000" placeholder="Shown on the client's ticket page and e-mailed to them" required></textarea>
                        <button type="submit" class="btn btn-sm btn-info"><i class="fas fa-reply"></i> @(string.IsNullOrWhiteSpace(r.ClientReply) ? "Send reply" : "Send new reply")</button>
                    </form>
                </div>
            </div>
        }

        @if (Model.History.Count > 0)
        {
            <details class="mt-3">
                <summary class="text-muted small">Status history (@Model.History.Count)</summary>
                <table class="table table-sm table-striped mt-2 mb-0 small">
                    <thead><tr><th>When</th><th>From</th><th>To</th><th>By</th></tr></thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr><td>@h.ChangedOn.ToString("dd MMM yyyy HH:mm")</td><td>@(h.FromStatus ?? "(created)")</td><td>@h.ToStatus</td><td>@h.ChangedByName</td></tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    </div>
</div>
