@model List<XFLCSMS.Models.Feedback.SlaTarget>
@using XFLCSMS.Models.Feedback
@{
    Layout = "_Layout";
    ViewData["Title"] = "SLA Targets";
    ViewData["Subtitle"] = "Used by the Engineer Scorecard. Targets are calendar minutes from the time the ticket was raised.";
}

<section class="content">
    <div class="container-fluid">
        @if (ViewBag.message != null)
        {
            <div class="alert alert-danger">@ViewBag.message</div>
        }
        <div class="card" style="max-width: 760px;">
            <div class="card-body">
                <form asp-controller="Admin" asp-action="SlaTargets" method="post">
                    <table class="table table-sm">
                        <thead><tr><th>Priority</th><th>First response (minutes)</th><th>Resolution (minutes)</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td><input type="hidden" name="targets[@i].Priority" value="@Model[i].Priority" /><b>@Model[i].Priority</b></td>
                                    <td>
                                        <input type="number" step="1" min="1" max="129600" name="targets[@i].FirstResponseMinutes" value="@Model[i].FirstResponseMinutes" class="form-control form-control-sm sla-minutes" required />
                                        <small class="text-muted sla-readable">@Duration.Format(Model[i].FirstResponseMinutes)</small>
                                    </td>
                                    <td>
                                        <input type="number" step="1" min="1" max="525600" name="targets[@i].ResolutionMinutes" value="@Model[i].ResolutionMinutes" class="form-control form-control-sm sla-minutes" required />
                                        <small class="text-muted sla-readable">@Duration.Format(Model[i].ResolutionMinutes)</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="small text-muted">Examples: 30 = 30 minutes, 90 = 1h 30m, 480 = 8 hours, 1440 = 1 day.</p>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
                </form>
            </div>
        </div>
    </div>
</section>
<script>
    document.querySelectorAll('.sla-minutes').forEach(function (input) {
        input.addEventListener('input', function () {
            var m = parseInt(input.value, 10), out = input.parentNode.querySelector('.sla-readable');
            if (!out) { return; }
            if (isNaN(m) || m < 1) { out.textContent = '-'; return; }
            if (m < 60) { out.textContent = m + 'm'; return; }
            if (m < 1440) { out.textContent = Math.floor(m / 60) + 'h' + (m % 60 ? ' ' + (m % 60) + 'm' : ''); return; }
            var h = Math.floor((m % 1440) / 60);
            out.textContent = Math.floor(m / 1440) + 'd' + (h ? ' ' + h + 'h' : '');
        });
    });
</script>
