@model XFLCSMS.Models.Branch.BranchView
@{
    ViewData["Title"] = "Add Branch";
    ViewData["Subtitle"] = "Branches of each brokerage house.";
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="BranchList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <form asp-controller="Admin" asp-action="CreateBranch" method="post" novalidate>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group">
                        <label asp-for="BranchName">Branch name <span class="text-danger">*</span></label>
                        <input asp-for="BranchName" class="form-control" placeholder="e.g. Motijheel" autocomplete="off" />
                        <span asp-validation-for="BranchName" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="BrokerageId">Brokerage house <span class="text-danger">*</span></label>
                        <select asp-for="BrokerageId" class="form-control custom-select">
                            <option value="">Select a brokerage house</option>
                            @foreach (var b in Model.brocarage ?? new List<XFLCSMS.Models.Brocarage.Brokerage>())
                            {
                                <option value="@b.BrokerageId" selected="@(b.BrokerageId == Model.BrokerageId)">@b.BrokerageHouseName</option>
                            }
                        </select>
                        <span asp-validation-for="BrokerageId" class="invalid-feedback d-block"></span>
                    </div>
                </div>
                <div class="card-footer xfl-form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Add Branch</button>
                    <a class="btn btn-outline-secondary" asp-action="BranchList">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
