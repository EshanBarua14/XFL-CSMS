@model XFLCSMS.Models.Brocarage.Brokerage
@{
    ViewData["Title"] = "Edit Brokerage House";
    ViewData["Subtitle"] = "The brokerage houses whose users raise tickets.";
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="BrocarageHouseList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <form asp-controller="Admin" asp-action="UpdateBrocarage" method="post" novalidate>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="BrokerageId" />
                    <div class="form-group">
                        <label>ID</label>
                        <input class="form-control" value="@Model.BrokerageId" readonly />
                    </div>
                    <div class="form-group">
                        <label asp-for="BrokerageHouseName">Brokerage house name <span class="text-danger">*</span></label>
                        <input asp-for="BrokerageHouseName" class="form-control" placeholder="e.g. Xpert Securities Ltd." autocomplete="off" />
                        <span asp-validation-for="BrokerageHouseName" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="BrokerageHouseAcronym">Acronym <span class="text-danger">*</span></label>
                        <input asp-for="BrokerageHouseAcronym" class="form-control" placeholder="e.g. XSL" autocomplete="off" />
                        <span asp-validation-for="BrokerageHouseAcronym" class="invalid-feedback d-block"></span>
                    </div>
                </div>
                <div class="card-footer xfl-form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Save changes</button>
                    <a class="btn btn-outline-secondary" asp-action="BrocarageHouseList">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
