@model XFLCSMS.Models.Support.SupportType
@{
    ViewData["Title"] = Model.SType;
    ViewData["Subtitle"] = "Support Type #" + Model.SupportTypeId;
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="SupportTypeList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
    <a class="btn btn-primary" asp-action="EditSupportType" asp-route-id="@Model.SupportTypeId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
    <button type="button" class="btn btn-outline-danger" data-delete-url="/Admin/DeleteSupportType/@Model.SupportTypeId" data-delete-name="@Model.SType" data-delete-done="@Url.Action("SupportTypeList", "Admin")"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <div class="card-body">
                <dl class="row xfl-details mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.SupportTypeId</dd>
                    <dt class="col-sm-4">Support type</dt>
                    <dd class="col-sm-8">@Model.SType</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
