@model XFLCSMS.Models.Support.SupportSubCatagory
@{
    ViewData["Title"] = Model.SubCatagory;
    ViewData["Subtitle"] = "Sub-Category #" + Model.SupportSubCatagoryId;
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="SupportSubCatagoryList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
    <a class="btn btn-primary" asp-action="EditSupportSubCatagory" asp-route-id="@Model.SupportSubCatagoryId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
    <button type="button" class="btn btn-outline-danger" data-delete-url="/Admin/DeleteSupportSubCatagory/@Model.SupportSubCatagoryId" data-delete-name="@Model.SubCatagory" data-delete-done="@Url.Action("SupportSubCatagoryList", "Admin")"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <div class="card-body">
                <dl class="row xfl-details mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.SupportSubCatagoryId</dd>
                    <dt class="col-sm-4">Sub-category</dt>
                    <dd class="col-sm-8">@Model.SubCatagory</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
