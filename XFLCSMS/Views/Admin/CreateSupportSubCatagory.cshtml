@model XFLCSMS.Models.Support.SupportSubCatagory
@{
    ViewData["Title"] = "Add Sub-Category";
    ViewData["Subtitle"] = "Ticket sub-categories.";
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="SupportSubCatagoryList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <form asp-controller="Admin" asp-action="CreateSupportSubCatagory" method="post" novalidate>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group">
                        <label asp-for="SubCatagory">Sub-category <span class="text-danger">*</span></label>
                        <input asp-for="SubCatagory" class="form-control" placeholder="e.g. Login" autocomplete="off" />
                        <span asp-validation-for="SubCatagory" class="invalid-feedback d-block"></span>
                    </div>
                </div>
                <div class="card-footer xfl-form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Add Sub-Category</button>
                    <a class="btn btn-outline-secondary" asp-action="SupportSubCatagoryList">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
