@model XFLCSMS.Models.Support.SupportCatagory
@{
    ViewData["Title"] = Model.SCatagory;
    ViewData["Subtitle"] = "Category #" + Model.SupportCatagoryId;
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="SupportCatagoryList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
    <a class="btn btn-primary" asp-action="EditSupportCatagory" asp-route-id="@Model.SupportCatagoryId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
    <button type="button" class="btn btn-outline-danger" data-delete-url="/Admin/DeleteSupportCatagory/@Model.SupportCatagoryId" data-delete-name="@Model.SCatagory" data-delete-done="@Url.Action("SupportCatagoryList", "Admin")"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <div class="card-body">
                <dl class="row xfl-details mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.SupportCatagoryId</dd>
                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.SCatagory</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
