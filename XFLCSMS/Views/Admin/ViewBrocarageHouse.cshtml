@model XFLCSMS.Models.Brocarage.Brokerage
@{
    ViewData["Title"] = Model.BrokerageHouseName;
    ViewData["Subtitle"] = "Brokerage House #" + Model.BrokerageId;
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="BrocarageHouseList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
    <a class="btn btn-primary" asp-action="EditBrocarage" asp-route-id="@Model.BrokerageId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
    <button type="button" class="btn btn-outline-danger" data-delete-url="/Admin/DeleteBrocarage/@Model.BrokerageId" data-delete-name="@Model.BrokerageHouseName" data-delete-done="@Url.Action("BrocarageHouseList", "Admin")"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <div class="card-body">
                <dl class="row xfl-details mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.BrokerageId</dd>
                    <dt class="col-sm-4">Brokerage house name</dt>
                    <dd class="col-sm-8">@Model.BrokerageHouseName</dd>
                    <dt class="col-sm-4">Acronym</dt>
                    <dd class="col-sm-8">@Model.BrokerageHouseAcronym</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
