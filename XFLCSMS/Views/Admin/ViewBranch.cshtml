@model XFLCSMS.Models.Branch.BranchView
@{
    ViewData["Title"] = Model.BranchName;
    ViewData["Subtitle"] = "Branch #" + Model.BranchId;
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="BranchList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
    <a class="btn btn-primary" asp-action="EditBranch" asp-route-id="@Model.BranchId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
    <button type="button" class="btn btn-outline-danger" data-delete-url="/Admin/DeleteBranch/@Model.BranchId" data-delete-name="@Model.BranchName" data-delete-done="@Url.Action("BranchList", "Admin")"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <div class="card-body">
                <dl class="row xfl-details mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.BranchId</dd>
                    <dt class="col-sm-4">Branch name</dt>
                    <dd class="col-sm-8">@Model.BranchName</dd>
                    <dt class="col-sm-4">Brokerage house</dt>
                    <dd class="col-sm-8">@Model.BrokerageHouseName</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
