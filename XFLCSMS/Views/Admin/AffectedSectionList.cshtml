@model IEnumerable<XFLCSMS.Models.Affected.AffectedSection>
@{
    ViewData["Title"] = "Affected Sections";
    ViewData["Subtitle"] = "The parts of a product a ticket can affect.";
}
@section PageActions {
    <a class="btn btn-primary" asp-controller="Admin" asp-action="CreateAffectedSection"><i class="fas fa-plus mr-1"></i>Add Affected Section</a>
}
<div class="card xfl-table-card">
    <div class="card-body">
        <table class="table table-hover xfl-table" id="issuesTable">
            <thead>
                <tr>
                    <th style="width:80px">ID</th>
                    <th>Affected section</th>
                    <th class="text-right no-sort" style="width:260px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AffectedSectionId</td>
                        <td>@item.ASection</td>
                        <td class="text-right text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Admin" asp-action="ViewAffectedSection" asp-route-id="@item.AffectedSectionId"><i class="fas fa-eye mr-1"></i>View</a>
                            <a class="btn btn-outline-info btn-sm" asp-controller="Admin" asp-action="EditAffectedSection" asp-route-id="@item.AffectedSectionId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-delete-url="/Admin/DeleteAffectedSection/@item.AffectedSectionId" data-delete-name="@item.ASection"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
