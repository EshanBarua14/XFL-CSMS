@model XFLCSMS.Models.Support.SupportCatagory
@{
    ViewData["Title"] = "Add Category";
    ViewData["Subtitle"] = "Ticket categories.";
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="SupportCatagoryList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <form asp-controller="Admin" asp-action="CreateSupportCatagory" method="post" novalidate>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group">
                        <label asp-for="SCatagory">Category <span class="text-danger">*</span></label>
                        <input asp-for="SCatagory" class="form-control" placeholder="e.g. Software" autocomplete="off" />
                        <span asp-validation-for="SCatagory" class="invalid-feedback d-block"></span>
                    </div>
                </div>
                <div class="card-footer xfl-form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Add Category</button>
                    <a class="btn btn-outline-secondary" asp-action="SupportCatagoryList">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
