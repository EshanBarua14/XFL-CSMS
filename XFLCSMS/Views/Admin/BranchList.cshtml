@model IEnumerable<XFLCSMS.Models.Branch.BranchView>
@{
    ViewData["Title"] = "Branches";
    ViewData["Subtitle"] = "Branches of each brokerage house.";
}
@section PageActions {
    <a class="btn btn-primary" asp-controller="Admin" asp-action="CreateBranch"><i class="fas fa-plus mr-1"></i>Add Branch</a>
}
<div class="card xfl-table-card">
    <div class="card-body">
        <table class="table table-hover xfl-table" id="issuesTable">
            <thead>
                <tr>
                    <th style="width:80px">ID</th>
                    <th>Branch name</th>
                    <th>Brokerage house</th>
                    <th class="text-right no-sort" style="width:260px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.BranchId</td>
                        <td>@item.BranchName</td>
                        <td>@item.BrokerageHouseName</td>
                        <td class="text-right text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Admin" asp-action="ViewBranch" asp-route-id="@item.BranchId"><i class="fas fa-eye mr-1"></i>View</a>
                            <a class="btn btn-outline-info btn-sm" asp-controller="Admin" asp-action="EditBranch" asp-route-id="@item.BranchId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-delete-url="/Admin/DeleteBranch/@item.BranchId" data-delete-name="@item.BranchName"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
