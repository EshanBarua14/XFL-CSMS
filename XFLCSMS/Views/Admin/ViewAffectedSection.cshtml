@model XFLCSMS.Models.Affected.AffectedSection
@{
    ViewData["Title"] = Model.ASection;
    ViewData["Subtitle"] = "Affected Section #" + Model.AffectedSectionId;
}
@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="AffectedSectionList"><i class="fas fa-arrow-left mr-1"></i>Back to list</a>
    <a class="btn btn-primary" asp-action="EditAffectedSection" asp-route-id="@Model.AffectedSectionId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
    <button type="button" class="btn btn-outline-danger" data-delete-url="/Admin/DeleteAffectedSection/@Model.AffectedSectionId" data-delete-name="@Model.ASection" data-delete-done="@Url.Action("AffectedSectionList", "Admin")"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
}
<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card xfl-form-card">
            <div class="card-body">
                <dl class="row xfl-details mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.AffectedSectionId</dd>
                    <dt class="col-sm-4">Affected section</dt>
                    <dd class="col-sm-8">@Model.ASection</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
