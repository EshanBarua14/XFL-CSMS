@model XFLCSMS.Models.Admin.UserView;
@{
    ViewData["Title"] = "Edit User";
}



<section class="content">
    <form asp-controller="Admin" asp-action="UpdateUser" method="post">
        <div class="container-fluid">
@*             <br />
            <div class="row card card-primary text-center">
                <h4>Edit User</h4>
            </div> *@
            <div class="row">
                <!-- left column -->
                <div class="col-md-6">
                    <!-- general form elements -->
                    <div class="card card-primary">
                        <!-- /.card-header -->
                        <!-- form start -->
                                
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="exampleInputEmail1">User ID</label>
                                    <input type="text" asp-for= "@Model.Id"  value="@Model.Id" class="form-control" id="exampleInputEmail1" placeholder="User ID" readonly>
                                </div>

                                <div class="form-group">
                                    <label for="exampleInputEmail1">Full Name</label>
                                    <input type="text" asp-for="@Model.FullName" value="@Model.FullName" class="form-control" placeholder="Full Name" required maxlength="200">
                                </div>

                                <div class="form-group">
                                    <label for="exampleInputEmail1">User Name</label>
                                    <input type="text" asp-for="@Model.UserName" class="form-control" value="@Model.UserName" id="exampleInputEmail1" placeholder="User Name" readonly>
                                </div>

                                <div class="form-group">
                                    <label for="exampleInputEmail1">Email</label>
                                    <input type="email" asp-for="@Model.Email" value="@Model.Email" class="form-control" placeholder="Email" required maxlength="200">
                                </div>

                                <div class="form-group">
                                    <label for="exampleInputEmail1">Phone Number</label>
                                    <input type="tel" asp-for="@Model.PhonNumber" value="@Model.PhonNumber" class="form-control" placeholder="Phone Number" maxlength="30">
                                </div>
                                <div class="form-group">
                                    <label for="Designation">Designation</label>
                                    <input type="text" asp-for="@Model.Designation" value="@Model.Designation" class="form-control" placeholder="Designation" maxlength="100">
                                </div>
                                <div class="form-group">
                                    <label for="Department">Role (department)</label>
                                <select asp-for="@Model.Department" class="form-control" id="Department" name="Department">
                                    <option value="Maker">Maker</option>
                                    <option value="Support Maneger">Support Manager</option>
                                    <option value="Support Engineer">Support Engineer</option>
                                    <option value="Viewer">Viewer (CEO / MD, read-only)</option>

                                    <!-- Add more options as needed -->
                                </select>
                                </div>

                            </div>
                            <!-- /.card-body -->
                                
                    </div>
                    <!-- /.card -->
                </div>
                <!--/.col (left) -->
                <!-- right column -->
                <div class="col-md-6">
                    <!-- Form Element sizes -->
                    <div class="card card-primary">

                                

                            <div class="card-body">
                                <div class="form-group">
                                    <label for="exampleInputEmail1">Employee Id</label>
                                    <input type="text" asp-for="@Model.EmployeeId" value="@Model.EmployeeId" class="form-control" placeholder="Employee Id" maxlength="50">
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputEmail1">Brokerage House Name</label>
                                    <input type="text" asp-for="@Model.BrokerageHouseName" value="@Model.BrokerageHouseName" class="form-control" id="exampleInputEmail1" placeholder="Brokerage House Name" readonly>
                                </div>

                                <div class="form-group">
                                    <label for="exampleInputEmail1">Branch</label>
                                    <input type="text" asp-for="@Model.Branch" value="@Model.Branch" class="form-control" id="exampleInputEmail1" placeholder="Branch" readonly>
                                </div>

                                     

                                <div class="form-group">
                                    <label for="UCatagory">User Category</label>
                                    <select asp-for="@Model.UCatagory" class="form-control" id="UCatagory" name="UCatagory">
                                        <option value="False">Normal User</option>
                                        <option value="True">Admin</option>
                                        <!-- Add more options as needed -->
                                    </select>
                                </div>


                                <div class="form-group">
                                    <label for="UType">User Type</label>
                                    <select asp-for="@Model.UType" class="form-control" id="UType" name="UType">
                                        <option value="False">Outside User</option>
                                        <option value="True">XFL User</option>
                                        <!-- Add more options as needed -->
                                    </select>
                                    <small class="form-text text-muted">Set on save from Department and User Category: Support Manager, Support Engineer and Admin are XFL users; a Viewer of your own house (XFL) sees every house.</small>
                                </div>

                                <div class="form-group">
                                    <label for="UStatus">User Status</label>
                                    <select asp-for="@Model.UStatus" class="form-control" id="UStatus" name="UStatus">
                                        <option value="True">Enable</option>
                                        <option value= "False">Disable</option>
                                        <!-- Add more options as needed -->
                                    </select>
                                </div>



                            </div>
                            <!-- /.card-body -->
                                

                        <!-- /.card-body -->
                        <div class="card-footer xfl-form-actions justify-content-end">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Update User</button>
                        </div>
                    </div>
                    <!-- /.card -->
                </div>
                <!--/.col (right) -->
            </div>
            <!-- /.row -->
            <!-- /.card-body -->

        </div>


    </form>
        <!-- /.container-fluid -->
</section>
    <!-- /.content -->


<script type="text/javascript">
    // Define a function named preventback
    function preventback() {
        // Forward the browser's history by one step, effectively preventing the user from going back
        window.history.forward();
    }

    // Set a timeout to call the preventback function immediately after the script is executed
    // back button allowed

    // When the window loads, assign a null function to the onload event to effectively do nothing
    window.onload = function () { null };
</script>