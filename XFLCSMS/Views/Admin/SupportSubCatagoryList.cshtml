@model IEnumerable<XFLCSMS.Models.Support.SupportSubCatagory>
@{
    ViewData["Title"] = "Sub-Categories";
    ViewData["Subtitle"] = "Ticket sub-categories.";
}
@section PageActions {
    <a class="btn btn-primary" asp-controller="Admin" asp-action="CreateSupportSubCatagory"><i class="fas fa-plus mr-1"></i>Add Sub-Category</a>
}
<div class="card xfl-table-card">
    <div class="card-body">
        <table class="table table-hover xfl-table" id="issuesTable">
            <thead>
                <tr>
                    <th style="width:80px">ID</th>
                    <th>Sub-category</th>
                    <th class="text-right no-sort" style="width:260px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SupportSubCatagoryId</td>
                        <td>@item.SubCatagory</td>
                        <td class="text-right text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Admin" asp-action="ViewSupportSubCatagory" asp-route-id="@item.SupportSubCatagoryId"><i class="fas fa-eye mr-1"></i>View</a>
                            <a class="btn btn-outline-info btn-sm" asp-controller="Admin" asp-action="EditSupportSubCatagory" asp-route-id="@item.SupportSubCatagoryId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-delete-url="/Admin/DeleteSupportSubCatagory/@item.SupportSubCatagoryId" data-delete-name="@item.SubCatagory"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
