@model IEnumerable<XFLCSMS.Models.Support.SupportCatagory>
@{
    ViewData["Title"] = "Categories";
    ViewData["Subtitle"] = "Ticket categories.";
}
@section PageActions {
    <a class="btn btn-primary" asp-controller="Admin" asp-action="CreateSupportCatagory"><i class="fas fa-plus mr-1"></i>Add Category</a>
}
<div class="card xfl-table-card">
    <div class="card-body">
        <table class="table table-hover xfl-table" id="issuesTable">
            <thead>
                <tr>
                    <th style="width:80px">ID</th>
                    <th>Category</th>
                    <th class="text-right no-sort" style="width:260px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SupportCatagoryId</td>
                        <td>@item.SCatagory</td>
                        <td class="text-right text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Admin" asp-action="ViewSupportCatagory" asp-route-id="@item.SupportCatagoryId"><i class="fas fa-eye mr-1"></i>View</a>
                            <a class="btn btn-outline-info btn-sm" asp-controller="Admin" asp-action="EditSupportCatagory" asp-route-id="@item.SupportCatagoryId"><i class="fas fa-pencil-alt mr-1"></i>Edit</a>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-delete-url="/Admin/DeleteSupportCatagory/@item.SupportCatagoryId" data-delete-name="@item.SCatagory"><i class="fas fa-trash-alt mr-1"></i>Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
