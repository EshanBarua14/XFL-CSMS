@{
    Layout = null;
    int code = ViewBag.Code ?? 0;
    var (title, text) = code switch
    {
        404 => ("Page not found", "The page or item you asked for does not exist, was deleted, or you do not have access to it."),
        403 => ("Not allowed", "Your account does not have access to this page."),
        401 => ("Signed out", "Your session has ended. Please sign in again."),
        400 => ("Request refused", "The request could not be processed. If you submitted a form, reload the page and try again."),
        _ => ("Something went wrong", "The request could not be completed (code " + code + ").")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Xpert CSMS | @title</title>
    <partial name="_XflHead" />
</head>
<body class="hold-transition">
    <div class="container mt-5" style="max-width:640px">
        <div class="card card-outline card-warning">
            <div class="card-body text-center">
                <img src="~/img/xfl-logo-centered.png" alt="XFL" style="height:56px" class="mb-3" />
                <h1 class="h3">@title</h1>
                <p class="text-muted">@text</p>
                <a href="javascript:history.back()" class="btn btn-outline-secondary"><i class="fas fa-arrow-left mr-1"></i>Go back</a>
                <a href="~/" class="btn btn-primary"><i class="fas fa-home mr-1"></i>Start page</a>
            </div>
        </div>
    </div>
    <footer class="xfl-page-footer"><partial name="_XflFooter" /></footer>
</body>
</html>
