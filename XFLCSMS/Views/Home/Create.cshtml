@model XFLCSMS.Models.Brocarage.Brokerage

@{
    ViewData["Title"] = "Create";
    Layout = null;
}
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>XFL CSMS | Create Brokerage House</title>
    <partial name="_XflHead" />

</head>
<body>    
<h1>Create</h1>

<h4>Brokerage</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-controller="Home" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="BrokerageHouseName" class="control-label"></label>
                <input asp-for="BrokerageHouseName" class="form-control" />
                <span asp-validation-for="BrokerageHouseName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BrokerageHouseAcronym" class="control-label"></label>
                <input asp-for="BrokerageHouseAcronym" class="form-control" />
                <span asp-validation-for="BrokerageHouseAcronym" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

    <!-- bs-custom-file-input -->
    <script src="~/plugins/bs-custom-file-input/bs-custom-file-input.min.js"></script>
    <script src="~/js/maket_datatable.js"></script>

</body>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
