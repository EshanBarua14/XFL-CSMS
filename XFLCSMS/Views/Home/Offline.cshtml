@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Xpert CSMS | Offline</title>
    <partial name="_XflHead" />
</head>
<body class="hold-transition">
    <div class="container mt-5" style="max-width:640px">
        <div class="card card-outline card-secondary">
            <div class="card-body text-center">
                <img src="~/img/xfl-logo-centered.png" alt="XFL" style="height:56px" class="mb-3" />
                <h1 class="h3"><i class="fas fa-wifi mr-2 text-muted"></i>You are offline</h1>
                <p class="text-muted">Xpert CSMS needs a connection to the server to show and save tickets. Check your network and try again.</p>
                <button type="button" class="btn btn-primary" onclick="location.reload()"><i class="fas fa-redo mr-1"></i>Try again</button>
            </div>
        </div>
    </div>
    <footer class="xfl-page-footer"><partial name="_XflFooter" /></footer>
</body>
</html>
