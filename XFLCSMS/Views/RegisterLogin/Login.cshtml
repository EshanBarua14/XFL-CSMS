@model XFLCSMS.Models.Login.UserLoginRequest

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Xpert CSMS | Log in</title>
    <partial name="_XflHead" />

    <!-- icheck bootstrap -->
    <link rel="stylesheet" href="~/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <link rel="stylesheet" href="~/css/xfl-story.css" asp-append-version="true">
</head>


<body class="hold-transition login-page xfl-login">
    <main class="xl-shell">
        <div class="xl-story-col">
            <h1 class="xl-hero-title">Support that <span>moves</span>, from ticket to five stars.</h1>
            <p class="xl-hero-sub">Brokerage houses raise it, XFL assigns it, engineers solve it, and makers rate it.</p>
            <partial name="_LoginStory" />
        </div>

        <div class="xl-form-col">
            <div class="login-box">
                <div class="card card-outline card-primary">
                    <div class="card-header text-center">
                        <a href="~/" class="xfl-login-brand"><img src="~/img/xfl-logo-centered.png" alt="Xpert Fintech Limited" width="104" height="104"><span class="h1 xl-brand-name"><b>Xpert</b> <span class="xl-acro"><span>C</span><span>S</span><span>M</span><span>S</span></span></span></a>
                        @* the product name spelled out: each word rises in as its letter in "CSMS" lights up (css/xfl-story.css) *@
                        <p class="xl-expand"><span class="xl-word xl-word-x">Xpert</span> <span class="xl-word"><b>C</b>ustomer</span> <span class="xl-word"><b>S</b>upport</span> <span class="xl-word"><b>M</b>anagement</span> <span class="xl-word"><b>S</b>ystem</span></p>
                        <p class="login-box-msg">Sign in to start your session</p>
                    </div>

                    <div class="card-body">
                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-danger" role="alert">@ViewBag.Message</div>
                        }
                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success" role="alert">@TempData["Message"]</div>
                        }
                        <form asp-controller="RegisterLogin" asp-action="Login" method="post">
                            <div class="card">
                                <div class="card-body login-card-body">
                                    <div class="input-group mb-3">
                                        <input type="text" asp-for="UserId" class="form-control" placeholder="User Name or Email">
                                        <div class="input-group-append">
                                            <div class="input-group-text">
                                                <span class="fas fa-user"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="input-group mb-3">
                                        <input type="password" asp-for="Password" class="form-control" id="password" name="password" aria-describedby="passwordToggle" placeholder="Password">
                                        <button class="btn btn-outline-secondary" type="button" id="passwordToggle" onclick="togglePassword()">Show</button>
                                    </div>
                                    <div class="input-group mb-3">
                                        <div class="icheck-primary">
                                            <input type="checkbox" id="remember">
                                            <label for="remember">
                                                Remember Me
                                            </label>
                                        </div>

                                        <div class="input-group mb-3">
                                            <button type="submit" class="btn btn-primary btn-block btn-signin"><i class="fas fa-sign-in-alt mr-1"></i>Sign In</button>
                                        </div>
                                        <p class="mb-3">
                                            <a asp-action="ForgotPassword">I forgot my password</a>
                                        </p>
                                        <p class="input-group mb-3">
                                            <a asp-action="Register" class="text-center">Register a new membership</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const passwordToggle = document.getElementById('passwordToggle');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                passwordToggle.textContent = 'Hide';
            } else {
                passwordInput.type = 'password';
                passwordToggle.textContent = 'Show';
            }
        }
    </script>
    <script src="~/js/xfl-story.js" asp-append-version="true"></script>
    <footer class="xfl-page-footer"><partial name="_XflFooter" /></footer>
</body>
</html>
