@model XFLCSMS.Models.Register.Verify;
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Xpert CSMS | Forgot Password (v2)</title>
    <partial name="_XflHead" />

    <!-- icheck bootstrap -->
    <link rel="stylesheet" href="~/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
</head>

<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="~/" class="xfl-login-brand"><img src="~/img/xfl-logo-centered.png" alt="Xpert Fintech Limited" width="104" height="104"><span class="h1"><b>Xpert</b> CSMS</span></a>
            </div>


            <div class="card-body">
                <p class="login-box-msg">Forgot your password! <br> Here you can easily retrieve a new password.</p>
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-danger" role="alert">@ViewBag.Message</div>
                }
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-success" role="alert">@TempData["Message"]</div>
                }
                <form asp-controller="RegisterLogin" asp-action="ForgotPassword" method="post">
                    <div class="card">
                        <div class="card-body login-card-body">
                            <div class="input-group mb-3">
                                <input type="text" asp-for="Email" class="form-control" placeholder="Email or User Name">
                                <div class="input-group-append">
                                    <div class="input-group-text">
                                        <span class="fas fa-envelope"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-outline-primary btn-block">Request new password</button>
                                </div>
                                <!-- /.col -->
                                <p class="mt-3 mb-1">
                                    <a asp-action="Login">Login</a>
                                </p>
                            </div>
                        </div>
                     </div>
                </form>

            </div>
            <!-- /.login-card-body -->
        </div>
    </div>
    <!-- /.login-box -->
    <footer class="xfl-page-footer"><partial name="_XflFooter" /></footer>
</body>
</html>

