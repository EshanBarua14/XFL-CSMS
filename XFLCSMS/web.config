<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings. Publishing fills in processPath / arguments; see docs/DEPLOYMENT.md. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdout log: turn on only to diagnose a site that does not start (Serilog files cover everything else) -->
      <aspNetCore processPath="dotnet" arguments=".\XFLCSMS.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 30 MB per request (attachments are limited to 10 MB each) -->
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
